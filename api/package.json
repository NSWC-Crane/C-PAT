{
  "name": "cpat-api",
  "version": "1.4.3",
  "description": "C-PAT API",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "node --test",
    "build": "cd ../client && npm run build",
    "offline-rebuild": "cd ../client && npm run build && cd ../api && node index.js",
    "format": "prettier --write \"**/*.js\" --cache",
    "format:check": "prettier --check \"**/*.js\"",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "lint:spec": "redocly lint specification/C-PAT.yaml --extends recommended"
  },
  "author": "Christian Rodriguez",
  "license": "ISC",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.44",
    "@ai-sdk/cerebras": "^3.0.39",
    "@ai-sdk/cohere": "^4.0.33",
    "@ai-sdk/deepinfra": "^3.0.39",
    "@ai-sdk/fireworks": "^3.0.42",
    "@ai-sdk/google": "^4.0.54",
    "@ai-sdk/groq": "^4.0.33",
    "@ai-sdk/mistral": "^4.0.35",
    "@ai-sdk/openai": "^4.0.50",
    "@ai-sdk/openai-compatible": "^3.0.39",
    "@ai-sdk/perplexity": "^4.0.34",
    "@ai-sdk/replicate": "^3.0.33",
    "@ai-sdk/togetherai": "^3.0.40",
    "@ai-sdk/xai": "^4.0.47",
    "ai": "^7.0.83",
    "async-retry": "^1.3.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-http-proxy": "^2.1.2",
    "express-openapi-validator": "^5.6.2",
    "express-rate-limit": "^8.6.2",
    "fast-csv": "^5.0.7",
    "js-yaml": "^5.4.1",
    "jsonpath-plus": "^10.4.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mysql2": "^3.24.2",
